---
// Steps through its <Frame> children one at a time. Without JavaScript the
// frames simply appear one after another.
import Controls from './Controls.astro';
---

<step-player class="player" tabindex="0" role="group" aria-label="Step-through diagram">
  <div class="frames"><slot /></div>
  <Controls />
</step-player>

<script>
  import { attachStepper } from '../lib/stepper';

  class StepPlayer extends HTMLElement {
    connectedCallback() {
      const frames = [...this.querySelectorAll<HTMLElement>('.frame')];
      if (frames.length < 2) return;
      this.dataset.ready = '';
      attachStepper(this, {
        count: () => frames.length,
        render: (index) => frames.forEach((frame, n) => frame.classList.toggle('on', n === index)),
      });
    }
  }

  customElements.define('step-player', StepPlayer);
</script>
