---
// Short codes drawn in 3D. Corners are words, edges are single bit flips, and
// walking from the sent word to the received one counts the damage. Three-bit
// codes make a cube; four-bit codes unfold it into a tesseract.
import { codes, judge, tone, type Bits, type CodeId } from '../lib/code-cube';

interface Props {
  code?: CodeId;
  bits?: Bits;
  /** `hero` plays a short loop with no controls, for the home page. */
  variant?: 'figure' | 'hero';
}

const { code: start = 'repeat', bits: startBits = 3, variant = 'figure' } = Astro.props;
const code = codes[startBits][start];
const sent = code.words[0];
const verdict = judge(code, sent, sent);
---

<code-cube
  class:list={['plate', 'code-cube', variant]}
  data-code={start}
  data-bits={startBits}
  data-variant={variant}
>
  <div class="plate-stage">
    <div
      class="plate-canvas"
      role="img"
      aria-label="Every word of three bits is a corner of a cube, and every word of four bits a corner of a tesseract, two cubes joined corner to corner. Each edge joins two words that differ in one bit, so the number of edges between two corners is their Hamming distance."
    >
    </div>
    <div class="plate-labels" aria-hidden="true"></div>
    {variant === 'figure' && <p class="plate-hint">Drag to turn. Click a corner to make it the received word.</p>}
    <p class="plate-fallback" hidden>This figure needs WebGL to draw. The controls and readout still work.</p>
  </div>

  {
    variant === 'figure' ? (
      <div class="plate-panel">
        <div class="plate-col">
          <div class="plate-group" role="group" aria-label="Word length">
            <span class="plate-caption">Word length</span>
            <div class="plate-buttons">
              <button type="button" data-bits="3" aria-pressed={String(startBits === 3)}>3 bits, a cube</button>
              <button type="button" data-bits="4" aria-pressed={String(startBits === 4)}>4 bits, a tesseract</button>
            </div>
          </div>
          <div class="plate-group" role="group" aria-label="Code">
            <span class="plate-caption">Code</span>
            <div class="plate-buttons">
              {Object.values(codes[startBits]).map((c) => (
                <button type="button" data-code={c.id} aria-pressed={String(c.id === start)}>
                  {c.name}
                </button>
              ))}
            </div>
          </div>
          <p class="plate-note" data-out="summary">{code.summary}</p>
          <dl class="plate-facts">
            <div><dt>Codewords</dt><dd data-out="count">{code.words.length}</dd></div>
            <div><dt>Minimum distance</dt><dd data-out="distance">{code.distance}</dd></div>
            <div><dt>Rate</dt><dd data-out="rate">{code.dataBits}/{startBits}</dd></div>
          </dl>
        </div>

        <div class="plate-col">
          <div class="plate-group" role="group" aria-label="Send a codeword">
            <span class="plate-caption">Send</span>
            <div class="plate-buttons" data-out="words" data-shows={`${startBits}-${start}`}>
              {code.words.map((w) => (
                <button type="button" class="word" data-send={w} aria-pressed={String(w === sent)}>
                  {w}
                </button>
              ))}
            </div>
          </div>

          <div class="plate-group" role="group" aria-label="Flip a bit in transit">
            <span class="plate-caption">Flip in transit</span>
            <div class="plate-buttons">
              {[1, 2, 3, 4].map((b) => (
                <button type="button" class={`flip b${b}`} data-flip={b - 1} hidden={b > startBits}>
                  Bit {b}
                </button>
              ))}
              <button type="button" class="undo" data-act="reset">Undo damage</button>
            </div>
          </div>

          <dl class="plate-facts">
            <div><dt>Sent</dt><dd class="word" data-out="sent">{sent}</dd></div>
            <div><dt>Received</dt><dd class="word" data-out="received">{sent}</dd></div>
            <div><dt>Bits flipped</dt><dd data-out="flips">0</dd></div>
          </dl>
        </div>
        <p class="plate-verdict" data-out="verdict" data-tone={tone[verdict.outcome]} aria-live="polite">{verdict.text}</p>
      </div>
    ) : (
      <p class="plate-verdict hero-caption" data-out="verdict" data-tone={tone[verdict.outcome]}>{verdict.text}</p>
    )
  }
</code-cube>

<script>
  import { codes, flip, judge, tone, walk, type Bits, type Code, type CodeId } from '../lib/code-cube';
  import type { CodeCubeScene } from '../lib/code-cube-scene';

  // The hero loop: each line is a code, a word to send, and the bits to flip.
  // It opens on a cube, then unfolds it into a tesseract.
  const reel: [Bits, CodeId, string, number[]][] = [
    [3, 'repeat', '000', [1]],
    [4, 'repeat', '0000', [2]],
    [4, 'repeat', '1111', [0, 3]],
    [4, 'repeat', '0000', [0, 1, 3]],
    [4, 'parity', '0110', [3]],
  ];

  class CodeCube extends HTMLElement {
    private code: Code = codes[3].repeat;
    private sent = '000';
    private path: string[] = ['000'];
    private scene?: CodeCubeScene;
    private timers: number[] = [];

    connectedCallback() {
      const bits = Number(this.dataset.bits ?? 3) as Bits;
      this.code = codes[bits][(this.dataset.code as CodeId) ?? 'repeat'];
      this.sent = this.code.words[0];
      this.path = [this.sent];
      const hero = this.dataset.variant === 'hero';
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.addEventListener('click', (event) => {
        const set = (event.target as HTMLElement).closest('button')?.dataset;
        if (!set) return;
        if (set.bits) this.choose(Number(set.bits) as Bits, this.code.id);
        else if (set.code) this.choose(this.code.bits, set.code as CodeId);
        else if (set.send) this.send(set.send);
        else if (set.flip !== undefined) this.receive(flip(this.received, Number(set.flip)), true);
        else if (set.act === 'reset') this.send(this.sent);
      });

      // Three.js is only fetched once the figure is close to the screen.
      const near = new IntersectionObserver(
        async ([entry]) => {
          if (!entry.isIntersecting) return;
          near.disconnect();
          try {
            const { CodeCubeScene } = await import('../lib/code-cube-scene');
            this.scene = new CodeCubeScene(
              this.querySelector<HTMLElement>('.plate-canvas')!,
              this.querySelector<HTMLElement>('.plate-labels')!,
              {
                reducedMotion,
                autoRotate: true,
                interactive: !hero,
                onPick: (word) => this.receive(word, false),
              },
            );
            this.render();
            if (hero && !reducedMotion) this.timers.push(window.setTimeout(() => this.play(0), 2600));
          } catch {
            this.querySelector<HTMLElement>('.plate-fallback')!.hidden = false;
            this.classList.add('no-webgl');
          }
        },
        { rootMargin: '200px' },
      );
      near.observe(this);
      this.render();
    }

    disconnectedCallback() {
      this.timers.forEach(clearTimeout);
      this.scene?.dispose();
    }

    private get received() {
      return this.path.at(-1)!;
    }

    private play(index: number) {
      const [bits, id, word, flips] = reel[index % reel.length];
      const unfolding = bits !== this.code.bits;
      this.code = codes[bits][id];
      this.send(word);
      // Give the tesseract time to unfold before damaging anything.
      const start = unfolding ? 2600 : 1400;
      flips.forEach((bit, i) => {
        this.timers.push(window.setTimeout(() => this.receive(flip(this.received, bit), true), start + i * 700));
      });
      this.timers.push(window.setTimeout(() => this.play(index + 1), start + flips.length * 700 + 3200));
    }

    /** Switch code or word length, keeping the sent word where it still makes sense. */
    private choose(bits: Bits, id: CodeId) {
      const before = this.sent;
      this.code = codes[bits][id];
      const carried = before.length === bits ? before : bits === 4 ? `${before}0` : before.slice(0, 3);
      this.send(this.code.words.includes(carried) ? carried : this.code.words[0]);
    }

    private send(word: string) {
      this.sent = word;
      this.path = [word];
      this.render();
    }

    /** Move the received word, one flip at a time so the packet follows edges. */
    private receive(word: string, step: boolean) {
      this.path = step ? [...this.path, word] : [...this.path, ...walk(this.received, word).slice(1)];
      this.render();
    }

    private render() {
      const { code, sent } = this;
      const received = this.received;
      const verdict = judge(code, sent, received);
      const out = (name: string) => this.querySelector<HTMLElement>(`[data-out="${name}"]`);

      this.querySelectorAll<HTMLElement>('button[data-bits]').forEach((b) =>
        b.setAttribute('aria-pressed', String(Number(b.dataset.bits) === code.bits)),
      );
      this.querySelectorAll<HTMLElement>('button[data-code]').forEach((b) => {
        const id = b.dataset.code as CodeId;
        b.textContent = codes[code.bits][id].name;
        b.setAttribute('aria-pressed', String(id === code.id));
      });
      this.querySelectorAll<HTMLElement>('button[data-flip]').forEach((b) => {
        b.hidden = Number(b.dataset.flip) >= code.bits;
      });
      const words = out('words');
      const shows = `${code.bits}-${code.id}`;
      if (words && words.dataset.shows !== shows) {
        words.dataset.shows = shows;
        words.innerHTML = code.words
          .map((w) => `<button type="button" class="word" data-send="${w}">${w}</button>`)
          .join('');
      }
      this.querySelectorAll<HTMLElement>('[data-send]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.send === sent)),
      );

      const text: Record<string, string> = {
        summary: code.summary,
        count: String(code.words.length),
        distance: String(code.distance),
        rate: `${code.dataBits}/${code.bits}`,
        sent,
        received,
        flips: String([...sent].filter((b, i) => b !== received[i]).length),
      };
      for (const [name, value] of Object.entries(text)) {
        const el = out(name);
        if (el) el.textContent = value;
      }
      const v = out('verdict')!;
      v.textContent = verdict.text;
      v.dataset.tone = tone[verdict.outcome];

      this.scene?.set({ code, sent, path: this.path, decoded: verdict.decoded, outcome: verdict.outcome });
    }
  }

  customElements.define('code-cube', CodeCube);
</script>
