---
import Figure from './Figure.astro';
import { arrowHead, fit } from './geom';

type Key = string | number;
/**
 * A node is a key, a list of keys (one multi-key node), `null` (an empty child
 * slot) or `{ k, c }` for a node with children.
 */
type Input = Key | Key[] | null | { k: Key | Key[]; c?: Input[] };

interface Props {
  root?: Input;
  /** Several trees side by side, for a forest. */
  roots?: Input[];
  highlight?: Key[];
  alt?: Key[];
  dim?: Key[];
  /** Draw every node as a row of key cells with edges leaving between the keys. */
  btree?: boolean;
  /** Colour nodes as in a red-black tree. */
  red?: Key[];
  black?: Key[];
  /** Small annotation beside a node, keyed by its first key, e.g. a balance factor. */
  notes?: Record<string, string>;
  /** Join the leaves left to right, as in a B+ tree. */
  linkLeaves?: boolean;
  /** Apply `highlight`, `alt` and `dim` to leaf nodes only (B+ trees repeat keys). */
  leafOnly?: boolean;
  /** Draw these nodes with a double outline, e.g. the ends of words in a trie. */
  terminal?: Key[];
  /** `last` shows only the final character of each key, so trie nodes can be keyed by prefix. */
  show?: 'key' | 'last';
  caption?: string;
  label?: string;
}

interface Node {
  keys: Key[];
  children: (Node | null)[];
  /** x of each child slot, including empty ones. */
  slots: number[];
  w: number;
  span: number;
  x: number;
  y: number;
}

const {
  root,
  roots,
  highlight = [],
  alt = [],
  dim = [],
  btree = false,
  red = [],
  black = [],
  notes = {},
  linkLeaves = false,
  leafOnly = false,
  terminal = [],
  show = 'key',
  caption,
  label,
} = Astro.props;

const KW = btree ? 36 : 40;
const NH = 36;
const GAP = btree ? 20 : 12;
const LEVEL = 68;
const PAD = Object.keys(notes).length ? 24 : 10;
const EMPTY = KW * 0.6 + GAP;
const labelWidth = (key: Key) => (show === 'last' ? 0 : String(key).length * 8.5 + 16);
const kw = (node: Node) => node.w / node.keys.length;

function build(input: Input): Node | null {
  if (input === null) return null;
  const node = typeof input === 'object' && !Array.isArray(input) ? input : { k: input };
  const keys = Array.isArray(node.k) ? node.k : [node.k];
  return {
    keys,
    children: (node.c ?? []).map(build),
    slots: [],
    // A single long label gets a wider pill instead of overflowing.
    w: keys.length === 1 && !btree ? Math.max(KW, labelWidth(keys[0])) : keys.length * KW,
    span: 0,
    x: 0,
    y: 0,
  };
}

function measure(node: Node): number {
  const below = node.children.reduce((sum, c) => sum + (c ? measure(c) : EMPTY), 0);
  node.span = Math.max(node.w + GAP, below);
  return node.span;
}

let depth = 0;
const nodes: Node[] = [];

function place(node: Node, left: number, level: number) {
  nodes.push(node);
  depth = Math.max(depth, level);
  node.y = PAD + level * LEVEL;
  if (!node.children.length) {
    node.x = left + node.span / 2;
    return;
  }
  const below = node.children.reduce((sum, c) => sum + (c ? c.span : EMPTY), 0);
  let cursor = left + (node.span - below) / 2;
  node.slots = node.children.map((child) => {
    const w = child ? child.span : EMPTY;
    if (child) place(child, cursor, level + 1);
    const x = child ? child.x : cursor + w / 2;
    cursor += w;
    return x;
  });
  node.x = (node.slots[0] + node.slots[node.slots.length - 1]) / 2;
}

const trees = (roots ?? [root ?? null]).map(build).filter((t): t is Node => t !== null);
const TREE_GAP = 14;
let cursor = PAD;
for (const tree of trees) {
  measure(tree);
  place(tree, cursor, 0);
  cursor += tree.span + TREE_GAP;
}

const width = cursor - TREE_GAP + PAD;
const text = (key: Key) => (show === 'last' ? String(key).slice(-1) || '·' : key);
const height = PAD * 2 + depth * LEVEL + NH;

const keyState = (node: Node, key: Key) => {
  const colour = red.includes(key) ? ' rb-red' : black.includes(key) ? ' rb-black' : '';
  if (leafOnly && node.children.length) return colour;
  const mark = highlight.includes(key)
    ? 'hl'
    : alt.includes(key)
      ? 'alt'
      : dim.includes(key)
        ? 'dim'
        : '';
  return mark + colour;
};
const marked = (node: Node) => node.keys.some((key) => /hl|alt/.test(keyState(node, key)));
const cells = (node: Node) => btree || node.keys.length > 1;

const leaves = nodes.filter((node) => !node.children.length);
const leafLinks = linkLeaves
  ? leaves.slice(1).map((leaf, i) => ({
      x1: leaves[i].x + leaves[i].w / 2,
      x2: leaf.x - leaf.w / 2,
      y: leaf.y + NH / 2,
    }))
  : [];

const edges = nodes.flatMap((node) =>
  node.children.flatMap((child, i) =>
    child
      ? [
          {
            x1: cells(node) ? node.x - node.w / 2 + i * kw(node) : node.x,
            y1: cells(node) ? node.y + NH : node.y + NH / 2,
            x2: child.x,
            y2: child.y,
            on: marked(node) && marked(child),
          },
        ]
      : [],
  ),
);
---

<Figure caption={caption}>
  <svg
    class="viz-svg"
    viewBox={`0 0 ${width} ${height}`}
    style={fit(width)}
    role="img"
    aria-label={label ?? `Tree with root ${trees.map((t) => t.keys.join(', ')).join('; ')}`}
  >
    {
      edges
        .sort((a, b) => Number(a.on) - Number(b.on))
        .map((e) => <line class={`v-edge ${e.on ? 'on' : ''}`} x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />)
    }
    {
      leafLinks.map((l) => (
        <g class="v-pointer">
          <line x1={l.x1} y1={l.y} x2={l.x2 - 6} y2={l.y} />
          <polygon points={arrowHead(l.x1, l.y, l.x2 - 1, l.y, 7)} />
        </g>
      ))
    }
    {
      nodes.map((node) =>
        notes[String(node.keys[0])] ? (
          <text class="v-label note" x={node.x + node.w / 2 + 3} y={node.y + 4}>
            {notes[String(node.keys[0])]}
          </text>
        ) : null,
      )
    }
    {
      nodes.map((node) =>
        node.keys.map((key, i) => (
          <g class={`v-node ${keyState(node, key)}`}>
            <rect
              x={node.x - node.w / 2 + i * kw(node)}
              y={node.y}
              width={kw(node)}
              height={NH}
              rx={cells(node) ? 4 : NH / 2}
            />
            {terminal.includes(key) && (
              <rect
                class="inner"
                x={node.x - node.w / 2 + i * kw(node) + 4}
                y={node.y + 4}
                width={kw(node) - 8}
                height={NH - 8}
                rx={(NH - 8) / 2}
              />
            )}
            <text class="v-text" x={node.x - node.w / 2 + (i + 0.5) * kw(node)} y={node.y + NH / 2}>
              {text(key)}
            </text>
          </g>
        )),
      )
    }
  </svg>
</Figure>
