---
import Figure from './Figure.astro';
import { arrowHead, fit } from './geom';
import { layoutGraph } from './graph-layout';

interface Props {
  /** Vertex name to `[column, row]` on a grid; fractions are fine. */
  nodes: Record<string, [number, number]>;
  /** `[from, to]` or `[from, to, weight]`. */
  edges: [string | number, string | number, (string | number)?][];
  directed?: boolean;
  highlight?: (string | number)[];
  alt?: (string | number)[];
  /** Edges to emphasise, as `[from, to]` pairs. */
  path?: [string | number, string | number][];
  caption?: string;
  label?: string;
}

const {
  nodes,
  edges,
  directed = false,
  highlight = [],
  alt = [],
  path = [],
  caption,
  label,
} = Astro.props;

const has = (list: (string | number)[], name: string) => list.map(String).includes(name);
const { points, lines: plain, width, height } = layoutGraph(nodes, edges, directed);
const lines = plain.map((line) => ({
  ...line,
  on: path.some(
    ([from, to]) =>
      (String(from) === line.from && String(to) === line.to) ||
      (!directed && String(from) === line.to && String(to) === line.from),
  ),
}));
---

<Figure caption={caption}>
  <svg
    class="viz-svg"
    viewBox={`0 0 ${width} ${height}`}
    style={fit(width)}
    role="img"
    aria-label={label ?? `${directed ? 'Directed graph' : 'Graph'} with ${Object.keys(nodes).length} vertices and ${edges.length} edges`}
  >
    {
      lines
        .sort((a, b) => Number(a.on) - Number(b.on))
        .map((l) => (
          <g class={`v-gedge ${l.on ? 'on' : ''}`}>
            <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />
            {directed && <polygon points={arrowHead(l.x1, l.y1, l.tip.x, l.tip.y, 9)} />}
            {l.weight !== undefined && (
              <text class="v-small" x={l.wx} y={l.wy}>{l.weight}</text>
            )}
          </g>
        ))
    }
    {
      points.map((p) => (
        <g class={`v-node ${has(highlight, p.name) ? 'hl' : has(alt, p.name) ? 'alt' : ''}`}>
          <rect x={p.x - p.hw} y={p.y - p.r} width={p.hw * 2} height={p.r * 2} rx={p.r} />
          <text class="v-text" x={p.x} y={p.y}>{p.name}</text>
        </g>
      ))
    }
  </svg>
</Figure>
