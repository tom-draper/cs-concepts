---
// An animated run of a sorting algorithm. The first step is drawn at build
// time as flat bars; in a browser with WebGL the script swaps in a 3D stage
// (src/lib/studio/sort-stage.ts) and replays the rest of the run on it.
import Controls from './Controls.astro';
import { trace, type Algorithm } from '../lib/sort-traces';

interface Props {
  algorithm: Algorithm;
  values?: number[];
}

const { algorithm, values = [5, 2, 8, 1, 9, 3, 7, 4] } = Astro.props;
const steps = trace(algorithm, values);
const first = steps[0];
const max = Math.max(...values);
const marks = { quick: 'pivot', selection: 'smallest so far' } as Record<string, string>;
---

<sort-demo
  class="sort-demo"
  tabindex="0"
  role="group"
  aria-label={`${algorithm} sort, step by step`}
  data-algorithm={algorithm}
  data-values={JSON.stringify(values)}
  data-pivot={algorithm === 'selection' ? 'min' : 'pivot'}
>
  <div class="sort-stage" aria-hidden="true" hidden>
    <p class="stage-hint">Drag to orbit · double-click to reset</p>
  </div>
  <div class="bars" aria-hidden="true">
    {
      first.values.map((value) => (
        <div class="bar" style={`--h:${(value / max) * 100}%`}>
          <i />
          <span>{value}</span>
        </div>
      ))
    }
  </div>
  <p class="sort-note" aria-live="polite">{first.note}</p>
  <Controls>
    <span class="inputs">
      <button type="button" data-input="shuffle">Shuffle</button>
      <button type="button" data-input="sorted">Sorted</button>
      <button type="button" data-input="reversed">Reversed</button>
    </span>
  </Controls>
  <p class="sort-meta">
    <span class="stats">
      <span><b data-stat="comparisons">0</b> comparisons</span>
      <span><b data-stat="writes">0</b> writes</span>
    </span>
    <span class="legend">
      <span class="k-compare">comparing</span>
      <span class="k-moved">moved</span>
      <span class="k-sorted">in final place</span>
      {marks[algorithm] && <span class="k-pivot">{marks[algorithm]}</span>}
    </span>
  </p>
</sort-demo>

<script>
  import { attachStepper } from '../lib/stepper';
  import { trace, type Algorithm, type SortStep } from '../lib/sort-traces';
  import { fontsReady, webglAvailable } from '../lib/studio/support';
  import type { SortStage } from '../lib/studio/sort-stage';

  class SortDemo extends HTMLElement {
    connectedCallback() {
      const algorithm = this.dataset.algorithm as Algorithm;
      const bars = [...this.querySelectorAll<HTMLElement>('.bar')];
      const note = this.querySelector('.sort-note')!;
      const stat = (name: string) => this.querySelector(`[data-stat="${name}"]`)!;
      let values: number[] = JSON.parse(this.dataset.values!);
      let steps: SortStep[] = trace(algorithm, values);
      let stage: SortStage | undefined;
      let current = 0;

      const stepper = attachStepper(this, {
        interval: 800,
        count: () => steps.length,
        render: (index) => {
          current = index;
          stage?.show(index);
          const step = steps[index];
          const max = Math.max(...step.values);
          bars.forEach((bar, i) => {
            bar.style.setProperty('--h', `${(step.values[i] / max) * 100}%`);
            bar.querySelector('span')!.textContent = String(step.values[i]);
            bar.className = 'bar';
            if (step.sorted.includes(i)) bar.classList.add('sorted');
            if (step.range && (i < step.range[0] || i > step.range[1])) bar.classList.add('out');
            if (step.pivot === i) bar.classList.add('pivot');
            if (step.compare.includes(i)) bar.classList.add('compare');
            if (step.moved.includes(i)) bar.classList.add('moved');
          });
          note.textContent = step.note;
          stat('comparisons').textContent = String(step.comparisons);
          stat('writes').textContent = String(step.writes);
        },
      });

      this.querySelector('.inputs')!.addEventListener('click', (event) => {
        const kind = (event.target as HTMLElement).closest('button')?.dataset.input;
        if (!kind) return;
        const ordered = [...values].sort((a, b) => a - b);
        if (kind === 'sorted') values = ordered;
        if (kind === 'reversed') values = ordered.reverse();
        if (kind === 'shuffle') {
          values = ordered;
          for (let i = values.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [values[i], values[j]] = [values[j], values[i]];
          }
        }
        steps = trace(algorithm, values);
        stage?.load(steps);
        stepper.go(0);
      });

      // Build the 3D stage only when the demo is about to scroll into view.
      if (!webglAvailable()) return;
      const near = new IntersectionObserver(
        async ([entry]) => {
          if (!entry.isIntersecting) return;
          near.disconnect();
          await fontsReady();
          const { SortStage } = await import('../lib/studio/sort-stage');
          const host = this.querySelector<HTMLElement>('.sort-stage')!;
          host.hidden = false;
          try {
            stage = new SortStage(host, values.length, Math.max(...values), {
              pivotLabel: this.dataset.pivot,
            });
            stage.load(steps);
            stage.show(current);
            this.dataset.stage = '';
          } catch (error) {
            host.hidden = true;
            console.warn('Could not start the 3D stage', error);
          }
        },
        { rootMargin: '300px' },
      );
      near.observe(this);
    }
  }

  customElements.define('sort-demo', SortDemo);
</script>
