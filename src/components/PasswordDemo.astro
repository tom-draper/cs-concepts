---
// How long a stolen password hash would take to crack, under a fast hash and
// a slow one, and what salting changes.
import { hex, sha256 } from '../lib/security';

const password = 'kittens';
const short = (text: string) => hex(sha256(text)).slice(0, 20);
---

<password-demo class="playground password-demo">
  <label>Password <input value={password} maxlength="40" spellcheck="false" autocomplete="off" /></label>
  <p class="tries">
    Try:
    {['kittens', 'password', 'Kittens7', 'k!Tt3n$-9z', 'purple-kettle-orbit-lamp'].map((item) => <button type="button" data-try={item}>{item}</button>)}
  </p>
  <dl class="readouts stacked" aria-live="polite">
    <div><dt>Possible passwords like it</dt><dd data-out="space">-</dd></div>
    <div><dt>Cracked if hashed with SHA-256</dt><dd data-out="fast">-</dd></div>
    <div><dt>Cracked if hashed with a slow hash</dt><dd data-out="slow">-</dd></div>
  </dl>
  <h4>Two users who chose this password</h4>
  <table class="grid">
    <thead><tr><th>user</th><th>stored without a salt</th><th>salt</th><th>stored with the salt</th></tr></thead>
    <tbody>
      <tr><td>alice</td><td data-out="plain-a">{short(password)}</td><td>9f3a</td><td data-out="salted-a">{short('9f3a' + password)}</td></tr>
      <tr><td>bob</td><td data-out="plain-b">{short(password)}</td><td>c81e</td><td data-out="salted-b">{short('c81e' + password)}</td></tr>
    </tbody>
  </table>
  <p class="hint" data-out="status" aria-live="polite">Estimates assume an attacker with a stolen database trying every possibility of this length and mix of characters.</p>
</password-demo>

<script>
  import { duration, FAST_RATE, hex, passwordStrength, sha256, SLOW_RATE } from '../lib/security';

  class PasswordDemo extends HTMLElement {
    connectedCallback() {
      const field = this.querySelector<HTMLInputElement>('label input')!;
      const out = (name: string) => this.querySelector(`[data-out="${name}"]`)!;
      const short = (text: string) => hex(sha256(text)).slice(0, 20);
      const render = () => {
        const password = field.value;
        const { pool, listed, guesses, bitsOfEntropy } = passwordStrength(password);
        out('space').textContent = listed ? 'it is on every list of common passwords' : `${pool}^${password.length}, about 2^${Math.round(bitsOfEntropy)}`;
        out('fast').textContent = listed ? 'at once' : duration(guesses / FAST_RATE);
        out('slow').textContent = listed ? 'at once' : duration(guesses / SLOW_RATE);
        out('plain-a').textContent = out('plain-b').textContent = short(password);
        out('salted-a').textContent = short('9f3a' + password);
        out('salted-b').textContent = short('c81e' + password);
        out('status').textContent = listed
          ? 'Attackers try known passwords first. No hash function can protect a password that is the first guess.'
          : 'The slow hash makes each guess a million times more expensive, for the attacker and nobody else. Without salts the two stored values are equal, so cracking one cracks both, and a table computed in advance cracks everyone.';
      };
      field.addEventListener('input', render);
      this.addEventListener('click', (event) => {
        const item = (event.target as HTMLElement).closest<HTMLElement>('[data-try]')?.dataset.try;
        if (!item) return;
        field.value = item;
        render();
      });
      render();
    }
  }

  customElements.define('password-demo', PasswordDemo);
</script>
