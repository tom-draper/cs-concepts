---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../lib/url';
import { pagesById } from '../outline';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
}

const {
  title,
  description = 'Visual Computer Science: a book of computer science concepts, each with figures you can turn, push and break.',
  currentId,
} = Astro.props;
const pageTitle = title ? `${title} | Visual Computer Science` : 'Visual Computer Science';
// The mark: a cube with one face in each process ink, one per bit.
const faces = [
  ['12,2.5 20.5,7.25 12,12 3.5,7.25', '#f5c431'],
  ['3.5,7.25 12,12 12,21.5 3.5,16.75', '#1bb8d4'],
  ['12,12 20.5,7.25 20.5,16.75 12,21.5', '#e03a8a'],
];
const mark = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">${faces
  .map(([points, fill]) => `<polygon points="${points}" fill="${fill}"/>`)
  .join('')}</svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(mark)}`;
// The running head, shown in the bar once the page's own title scrolls away.
const running = currentId ? pagesById.get(currentId) : undefined;
---

<!doctype html>
<html lang="en" data-base={url('')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400..700&family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,400..700&display=swap"
    />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show contents" />
    <header class="topbar">
      <label for="nav-toggle" class="icon-btn menu-btn" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="20" height="20"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>
      </label>
      <a class="brand" href={url('')}>
        <span class="mark" aria-hidden="true">
          <span class="cube">
            <i class="x"></i><i class="x far"></i><i class="y"></i><i class="y far"></i><i class="z"></i><i class="z far"></i>
          </span>
        </span>
        <span class="full">Visual Computer Science</span>
        <span class="short">VCS</span>
      </a>
      {
        running && (
          <a class="running-head" href="#" aria-label={`Back to the top of ${title ?? running.title}`}>
            <span class="chapter">{running.chapter}</span>
            <span class="sep" aria-hidden="true">›</span>
            <span class="title">{title ?? running.title}</span>
          </a>
        )
      }
      <button id="search-btn" class="search-btn" type="button">
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>
        <span>Search the book</span>
        <kbd>/</kbd>
      </button>
      <button id="theme-btn" class="icon-btn" type="button" aria-label="Switch between light and dark theme">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.75"></circle><path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor"></path></svg>
      </button>
      <span class="register" aria-hidden="true"><i class="c"></i><i class="m"></i><i class="y"></i></span>
    </header>

    <nav class="sidebar" aria-label="Contents">
      <Sidebar currentId={currentId} />
    </nav>
    <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

    <main>
      <slot />
    </main>

    <dialog id="search" class="search-dialog" aria-label="Search">
      <div id="search-ui"></div>
      <p id="search-fallback" class="search-fallback" hidden>
        Search is built with the site. Run <code>pnpm build &amp;&amp; pnpm preview</code> to use it locally.
      </p>
    </dialog>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const base = root.dataset.base;

        document.getElementById('theme-btn').addEventListener('click', () => {
          const current =
            root.dataset.theme ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });

        // Reading progress drives the register line and turns the mark.
        const bar = document.querySelector('.topbar');
        let queued = false;
        function measure() {
          queued = false;
          const room = root.scrollHeight - innerHeight;
          const read = room > 0 ? Math.min(1, Math.max(0, scrollY / room)) : 0;
          bar.style.setProperty('--read', read.toFixed(4));
        }
        addEventListener('scroll', () => {
          if (!queued) requestAnimationFrame(measure);
          queued = true;
        }, { passive: true });
        addEventListener('resize', measure);
        measure();

        // The running head takes over once the page's own title has scrolled away.
        const heading = document.querySelector('.prose h1');
        if (heading && bar.querySelector('.running-head')) {
          new IntersectionObserver(([entry]) => {
            bar.classList.toggle('running', !entry.isIntersecting && entry.boundingClientRect.top < 0);
          }, { rootMargin: `-${bar.offsetHeight}px 0px 0px 0px` }).observe(heading);
        }

        // Keep the current page visible in a long sidebar.
        document
          .querySelector('.sidebar [aria-current="page"]')
          ?.scrollIntoView({ block: 'center' });

        // Pagefind is only fetched the first time search is opened.
        const dialog = document.getElementById('search');
        let loading;
        function loadSearch() {
          loading ??= new Promise((resolve, reject) => {
            const css = document.createElement('link');
            css.rel = 'stylesheet';
            css.href = base + 'pagefind/pagefind-ui.css';
            const js = document.createElement('script');
            js.src = base + 'pagefind/pagefind-ui.js';
            js.onload = resolve;
            js.onerror = reject;
            document.head.append(css, js);
          })
            .then(() => {
              new PagefindUI({
                element: '#search-ui',
                showImages: false,
                showSubResults: true,
              });
            })
            .catch(() => {
              document.getElementById('search-fallback').hidden = false;
            });
          return loading;
        }
        async function openSearch() {
          if (dialog.open) return;
          dialog.showModal();
          await loadSearch();
          dialog.querySelector('input')?.focus();
        }
        document.getElementById('search-btn').addEventListener('click', openSearch);
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });

        document.addEventListener('keydown', (event) => {
          const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(event.target.tagName);
          if ((event.key === '/' && !typing) || (event.key === 'k' && (event.metaKey || event.ctrlKey))) {
            event.preventDefault();
            openSearch();
            return;
          }
          if (typing || dialog.open || event.metaKey || event.ctrlKey || event.altKey) return;
          const rel = { ArrowLeft: 'prev', ArrowRight: 'next' }[event.key];
          const link = rel && document.querySelector(`a[rel="${rel}"]`);
          if (link) location.href = link.href;
        });
      })();
    </script>
  </body>
</html>
